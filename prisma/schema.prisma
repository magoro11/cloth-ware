generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  cartItems                  CartItem[]
  id                         String             @id @default(cuid())
  name                       String?
  email                      String             @unique
  emailLower                 String             @unique
  phone                      String?
  addressLine1               String?
  addressLine2               String?
  city                       String?
  country                    String?
  preferredPaymentMethod     PaymentMethod?
  preferredFulfillmentMethod FulfillmentMethod?
  emailVerified              DateTime?
  image                      String?
  passwordHash               String?
  role                       UserRole           @default(CUSTOMER)
  isBanned                   Boolean            @default(false)
  stripeCustomerId           String?
  stripeConnectedId          String?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  accounts                   Account[]
  bookings                   Booking[]          @relation("BookingCustomer")
  ownedItems                 Item[]             @relation("ItemOwner")
  ownedProducts              Product[]          @relation("ProductSeller")
  orders                     Order[]            @relation("OrderCustomer")
  addresses                  Address[]          @relation("AddressUser")
  wishlistItems              WishlistItem[]
  receivedMessages           Message[]          @relation("MessageRecipient")
  reviewsWritten             Review[]           @relation("ReviewAuthor")
  sentMessages               Message[]          @relation("MessageSender")
  sessions                   Session[]
  transactions               Transaction[]
  wishlists                  Wishlist[]
  payouts                    Payout[]           @relation("OwnerPayouts")
  purchases                  Purchase[]         @relation("PurchaseBuyer")
}

model Item {
  id                 String              @id @default(cuid())
  ownerId            String
  title              String
  brand              String
  description        String
  category           String
  size               String
  condition          ItemCondition
  rentalPricePerDay  Int
  sellingPrice       Int?
  securityDeposit    Int
  featured           Boolean             @default(false)
  isAvailable        Boolean             @default(true)
  location           String?
  occasion           String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  availabilityBlocks AvailabilityBlock[]
  bookings           Booking[]
  cartItems          CartItem[]
  owner              User                @relation("ItemOwner", fields: [ownerId], references: [id])
  purchases          Purchase[]
  images             ItemImage[]
  repairs            RepairLog[]
  reviews            Review[]
  wishlistedBy       Wishlist[]
}

model ItemImage {
  id        String   @id @default(cuid())
  itemId    String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model AvailabilityBlock {
  id        String   @id @default(cuid())
  itemId    String
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Booking {
  id                     String             @id @default(cuid())
  itemId                 String
  customerId             String
  startDate              DateTime
  endDate                DateTime
  days                   Int
  rentalAmount           Int
  securityDeposit        Int
  lateFeeAmount          Int                @default(0)
  commissionAmount       Int
  ownerPayoutAmount      Int
  status                 BookingStatus      @default(PENDING)
  fulfillmentMethod      FulfillmentMethod?
  fulfillmentAddress     String?
  paymentMethod          PaymentMethod?
  mpesaPhone             String?
  mpesaCheckoutRequestId String?
  mpesaMerchantRequestId String?
  mpesaReceiptNumber     String?
  mpesaResultCode        Int?
  mpesaResultDesc        String?
  paidAt                 DateTime?
  returnDate             DateTime?
  damageReported         Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  customer               User               @relation("BookingCustomer", fields: [customerId], references: [id])
  item                   Item               @relation(fields: [itemId], references: [id])
  payout                 Payout?
  repairLogs             RepairLog[]
  transactions           Transaction[]

  @@index([itemId, startDate, endDate])
}

model Transaction {
  id                  String          @id @default(cuid())
  bookingId           String?
  userId              String?
  type                TransactionType
  amount              Int
  stripePaymentIntent String?
  stripeTransferId    String?
  metadata            Json?
  createdAt           DateTime        @default(now())
  booking             Booking?        @relation(fields: [bookingId], references: [id])
  user                User?           @relation(fields: [userId], references: [id])
}

model Payout {
  id         String       @id @default(cuid())
  bookingId  String       @unique
  ownerId    String
  amount     Int
  status     PayoutStatus @default(PENDING)
  releasedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  booking    Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  owner      User         @relation("OwnerPayouts", fields: [ownerId], references: [id])
}

model RepairLog {
  id                  String   @id @default(cuid())
  itemId              String
  bookingId           String?
  adminNote           String
  repairCost          Int
  deductedFromDeposit Int
  createdAt           DateTime @default(now())
  booking             Booking? @relation(fields: [bookingId], references: [id])
  item                Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(cuid())
  itemId    String?
  productId String?
  authorId  String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  item      Item?    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  product   Product? @relation("ProductReview", fields: [productId], references: [id], onDelete: Cascade)
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  createdAt DateTime @default(now())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId, createdAt])
}

model Purchase {
  id                      String         @id @default(cuid())
  itemId                  String
  buyerId                 String
  amount                  Int
  commissionAmount        Int
  stripeCheckoutSessionId String?
  stripePaymentIntent     String?
  status                  PurchaseStatus @default(PAID)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  buyer                   User           @relation("PurchaseBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  item                    Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([buyerId, createdAt])
  @@index([itemId])
  @@index([stripeCheckoutSessionId])
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  content     String
  createdAt   DateTime @default(now())
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender      User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  createdAt DateTime @default(now())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  CUSTOMER
  LENDER
  ADMIN
}

enum ItemCondition {
  NEW
  EXCELLENT
  GOOD
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELED
  LATE
}

enum TransactionType {
  RENTAL_PAYMENT
  DEPOSIT_HOLD
  COMMISSION
  PAYOUT
  REPAIR_DEDUCTION
  LATE_FEE
}

enum PayoutStatus {
  PENDING
  RELEASED
  FAILED
}

enum PurchaseStatus {
  PENDING
  PAID
  FULFILLED
  CANCELED
  REFUNDED
}

enum PaymentMethod {
  CARD
  MPESA
  PAYPAL
  COD
}

enum FulfillmentMethod {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  PENDING
  PAID
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  MPESA
  PAYPAL
  PAYSTACK
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELED
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  imageUrl  String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([slug])
}

model Product {
  id          String   @id @default(cuid())
  sellerId    String
  categoryId  String?
  slug        String   @unique
  title       String
  brand       String?
  description String
  basePrice   Int // minor units, default variant price when null
  isPublished Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  stockAlert  Int      @default(5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seller        User             @relation("ProductSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  category      Category?        @relation(fields: [categoryId], references: [id])
  variants      ProductVariant[]
  images        ProductImage[]
  reviews       Review[]         @relation("ProductReview")
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]   @relation("WishlistItems")

  @@index([sellerId])
  @@index([categoryId])
  @@index([slug])
  @@index([isPublished])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  sku       String   @unique
  size      String
  color     String?
  price     Int? // minor units override; null => product.basePrice
  stock     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeCartItems StoreCartItem[]
  orderItems     OrderItem[]

  @@index([productId])
  @@index([sku])
  @@index([size, color])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model StoreCart {
  id        String          @id @default(cuid())
  userId    String?
  sessionId String?
  items     StoreCartItem[]
  updatedAt DateTime        @updatedAt

  @@unique([userId, sessionId])
  @@index([userId])
  @@index([sessionId])
}

model StoreCartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  cart    StoreCart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  status          OrderStatus @default(PENDING)
  subtotal        Int // minor units
  shipping        Int         @default(0)
  tax             Int         @default(0)
  total           Int // minor units
  currency        String      @default("KES")
  shippingAddress Json?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user     User        @relation("OrderCustomer", fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  variantId   String?
  productName String // snapshot
  variantSku  String? // snapshot
  quantity    Int
  price       Int // minor units, snapshot
  createdAt   DateTime @default(now())

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String   @default("home")
  name       String
  phone      String
  line1      String
  line2      String?
  city       String
  country    String   @default("KE")
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation("AddressUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDefault])
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider
  providerPaymentId String          @unique
  status            PaymentStatus   @default(PENDING)
  amount            Int // minor units
  currency          String          @default("KES")
  paidAt            DateTime?
  rawResponse       Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerPaymentId])
  @@index([status])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation("WishlistItems", fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}
